import unittest
import numpy as np

from core.research_suite import verifier_power_study


class PowerStudyRegressionTests(unittest.TestCase):
    def test_power_study_regression_and_output_patch_attack(self):
        result = verifier_power_study(seeds=(42,), forget_fraction=0.10, n_retrains=3)

        # 3 good retrains + 5 legacy controls + 7 output-patch + 3 adaptive radius-patch controls.
        self.assertEqual(result["n"], 18)
        self.assertEqual(result["n_retrains"], 3)

        rows = result["rows"]
        bad_partials = [r for r in rows if r["label"].startswith("bad_partial_")]
        losses = [r["forget_loss"] for r in bad_partials]
        self.assertEqual(len(losses), 3)
        self.assertEqual(losses, sorted(losses))
        self.assertGreater(len(set(np.round(losses, 10))), 1)

        patch = [r for r in rows if r["algorithm"] == "output_patch"]
        self.assertEqual(len(patch), 7)
        self.assertEqual(result["output_patch_attack"]["candidate_count"], 7)
        self.assertEqual(
            result["output_patch_attack"]["accepted_count"],
            sum(r["calibration"]["certification_verdict"] == "PASS" for r in patch),
        )
        # V15: the query-only discontinuity axis must separate exact-input patches
        # from honest retrains (the V14 verifier accepted 6/7 of them).
        good_disc = [r["axes"]["discontinuity_consistency"] for r in rows if r["is_good"]]
        patch_disc = [r["axes"]["discontinuity_consistency"] for r in patch]
        self.assertLess(max(patch_disc), min(good_disc))
        self.assertEqual(result["output_patch_attack"]["accepted_count"], 0)
        self.assertEqual(len(result["adaptive_radius_patch"]["results"]), 3)
        self.assertEqual(
            result["output_patch_attack"]["accepted_labels"],
            [r["label"] for r in patch if r["calibration"]["certification_verdict"] == "PASS"],
        )

        # The plain MIA baseline must use the same real forget-loss quantity
        # for both GOOD and BAD rows; no accuracy-derived fallback is allowed.
        self.assertTrue(all("forget_loss" in r for r in rows))
        self.assertIn("plain_mia_auc", result)
        self.assertEqual(result["plain_mia_auc"]["n"], result["n"])
        self.assertEqual(result["plain_mia_bad_label_auc"]["n"], result["n"])


if __name__ == "__main__":
    unittest.main()
