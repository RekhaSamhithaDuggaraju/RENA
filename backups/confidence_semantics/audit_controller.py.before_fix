"""Reliability-aware staged evidence controller for RENA LLM audits.

Scores are verifier-supplied support signals in [0, 1], not probabilities.
The controller groups correlated signals, uses declared reliability weights,
records provenance and escalates uncertain/conflicting evidence. It does not
claim physical deletion or tune policy from held-out evaluation data.
"""
from __future__ import annotations

from dataclasses import asdict, dataclass, field
import math
from typing import Any, Callable, Mapping, Sequence


@dataclass(frozen=True)
class AuditPolicy:
    support_threshold: float = 0.75
    reject_threshold: float = 0.25
    max_disagreement: float = 0.30
    escalation_threshold: float = 0.20
    min_independent_groups: int = 2
    version: str = "rena-adaptive-audit-2.0"

    def __post_init__(self) -> None:
        if not (0 <= self.reject_threshold < self.support_threshold <= 1):
            raise ValueError("require 0 <= reject_threshold < support_threshold <= 1")
        if not (0 <= self.max_disagreement <= 1 and 0 <= self.escalation_threshold <= 0.5):
            raise ValueError("max_disagreement must be in [0,1] and escalation_threshold in [0,.5]")
        if self.min_independent_groups < 1:
            raise ValueError("min_independent_groups must be >= 1")


@dataclass
class AuditDecision:
    status: str
    confidence: float | None
    support_score_mean: float | None = None
    evidence: list[dict[str, Any]] = field(default_factory=list)
    escalated: bool = False
    escalation_reason: str | None = None
    policy: dict[str, Any] = field(default_factory=dict)
    limitations: list[str] = field(default_factory=list)
    independent_group_count: int = 0
    disagreement: float | None = None
    decision_note: str = ""

    def to_dict(self) -> dict[str, Any]:
        return asdict(self)


def _validate_score(name: str, raw: Mapping[str, Any]) -> tuple[float | None, float, str]:
    score = raw.get("score")
    if score is not None:
        if isinstance(score, bool) or not isinstance(score, (int, float)) or not math.isfinite(float(score)) or not 0 <= float(score) <= 1:
            raise ValueError(f"{name}: score must be None or a finite number in [0, 1]")
        score = float(score)
    reliability = raw.get("reliability", 1.0)
    if isinstance(reliability, bool) or not isinstance(reliability, (int, float)) or not math.isfinite(float(reliability)) or not 0 <= float(reliability) <= 1:
        raise ValueError(f"{name}: reliability must be a finite number in [0, 1]")
    group = raw.get("evidence_group", raw.get("verifier", name))
    if not isinstance(group, str) or not group.strip():
        raise ValueError(f"{name}: evidence_group must be a non-empty string")
    return score, float(reliability), group


def _independent_summary(evidence: Sequence[Mapping[str, Any]]) -> tuple[float | None, float | None, int]:
    """Average within declared dependence groups, then across groups by reliability."""
    groups: dict[str, list[tuple[float, float]]] = {}
    for row in evidence:
        score = row.get("score")
        if score is None:
            continue
        groups.setdefault(str(row["evidence_group"]), []).append((float(score), float(row["reliability"])))
    group_rows: list[tuple[float, float]] = []
    for values in groups.values():
        weights = [w for _, w in values]
        total = sum(weights)
        if total > 0:
            group_score = sum(s * w for s, w in values) / total
            # One group's influence is capped at its mean declared reliability.
            group_rows.append((group_score, total / len(values)))
    total_weight = sum(w for _, w in group_rows)
    if total_weight <= 0:
        return None, None, len(groups)
    mean = sum(s * w for s, w in group_rows) / total_weight
    disagreement = max(s for s, _ in group_rows) - min(s for s, _ in group_rows) if len(group_rows) > 1 else 0.0
    return mean, disagreement, len(group_rows)


def _status(mean: float | None, disagreement: float | None, groups: int, policy: AuditPolicy) -> str:
    if mean is None or groups < policy.min_independent_groups:
        return "INSUFFICIENT_EVIDENCE"
    if disagreement is not None and disagreement > policy.max_disagreement:
        return "ABSTAIN"
    if mean >= policy.support_threshold:
        return "SUPPORTED"
    if mean <= policy.reject_threshold:
        return "NOT_SUPPORTED"
    return "PARTIALLY_SUPPORTED"


def run_adaptive_audit(
    initial_checks: Mapping[str, Callable[[], Mapping[str, Any]]],
    escalation_checks: Mapping[str, Callable[[], Mapping[str, Any]]],
    policy: AuditPolicy = AuditPolicy(),
    force_escalation: bool = False,
) -> AuditDecision:
    """Run staged checks once each and return an auditable conservative decision.

    A check returns `score` (0..1; higher means more support for the forgetting
    claim), optional `reliability` (default 1), `evidence_group`, `metric`,
    `details`, `evidence_id`, and `limitations`. Reliability is a declared
    weight, not an empirically calibrated probability.
    """
    evidence: list[dict[str, Any]] = []

    def execute(stage: str, checks: Mapping[str, Callable[[], Mapping[str, Any]]]) -> None:
        for name, check in checks.items():
            raw = check()
            if not isinstance(raw, Mapping):
                raise TypeError(f"{name}: check must return a mapping")
            row = dict(raw)
            score, reliability, group = _validate_score(name, row)
            row.setdefault("evidence_id", f"{stage}:{name}")
            row.setdefault("verifier", name)
            if not isinstance(row["evidence_id"], str) or not row["evidence_id"].strip():
                raise ValueError(f"{name}: evidence_id must be a non-empty string")
            row["score"] = score
            row["reliability"] = reliability
            row["evidence_group"] = group
            row["stage"] = stage
            evidence.append(row)

    execute("initial", initial_checks)
    initial_mean, initial_disagreement, initial_groups = _independent_summary(evidence)
    uncertain = initial_mean is None or initial_groups < policy.min_independent_groups or (
        policy.escalation_threshold < initial_mean < 1 - policy.escalation_threshold
    )
    conflict = initial_disagreement is not None and initial_disagreement > policy.max_disagreement
    should_escalate = bool(escalation_checks) and (uncertain or conflict or force_escalation)
    reason = ("sentinel_escalation" if force_escalation and not (uncertain or conflict) else
              "insufficient_or_uncertain_initial_evidence" if uncertain else
              "conflicting_initial_evidence" if conflict else None)
    if should_escalate:
        execute("escalation", escalation_checks)

    mean, disagreement, groups = _independent_summary(evidence)
    status = _status(mean, disagreement, groups, policy)
    return AuditDecision(
        status=status,
        # A score mean is not a calibrated probability. Do not expose it
        # as confidence when the policy says evidence is insufficient.
        confidence=mean if status != "INSUFFICIENT_EVIDENCE" else None,
        support_score_mean=mean,
        evidence=evidence,
        escalated=should_escalate,
        escalation_reason=reason,
        policy=asdict(policy),
        limitations=[
            "Scores and reliability weights are supplied by external verifiers; weights are not probabilities.",
            "Signals sharing an evidence_group are aggregated together to reduce double-counting of correlated checks.",
            "A supported behavioral audit is not proof of physical parameter erasure.",
            "Thresholds and reliability weights must be fixed using development/calibration data before held-out evaluation.",
            "Synthetic facts and lexical matching do not establish real-world unlearning performance.",
        ],
        independent_group_count=groups,
        disagreement=disagreement,
        decision_note="Status is a policy-based evidence classification, not a calibrated probability of forgetting.",
    )
