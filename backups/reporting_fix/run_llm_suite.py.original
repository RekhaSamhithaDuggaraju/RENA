"""Run matched RENA LLM baselines and evaluate each checkpoint with NIAH.

Each method is initialized independently from the same model ID/path. This
prevents one method's updates from contaminating another. The script requires
the optional LLM dependencies and a locally available or downloadable model.
"""
from __future__ import annotations
import argparse
import hashlib
import json
import random
import time
from pathlib import Path

import numpy as np
from core.llm import METHODS, TrainConfig, build_synthetic_knowledge, build_niah_cases, run_niah_benchmark
from core.llm.knowledge import knowledge_hash
from core.llm.unlearning import train_on_facts, unlearn_model
from core.llm.audit_controller import AuditPolicy, run_adaptive_audit


def load_model(model_id: str, device: str):
    try:
        import torch
        from transformers import AutoModelForCausalLM, AutoTokenizer
    except ImportError as exc:
        raise SystemExit("Install optional dependencies with: python3 -m pip install -r requirements-llm.txt") from exc
    if device == "auto":
        device = "cuda" if torch.cuda.is_available() else ("mps" if getattr(torch.backends, "mps", None) and torch.backends.mps.is_available() else "cpu")
    tokenizer = AutoTokenizer.from_pretrained(model_id)
    model = AutoModelForCausalLM.from_pretrained(model_id).to(device)
    model.eval()
    return model, tokenizer, device


def generator_for(model, tokenizer, device: str, max_new_tokens: int):
    import torch
    context_limit = getattr(model.config, "max_position_embeddings", None) or getattr(model.config, "n_positions", None)
    if tokenizer.pad_token_id is None:
        tokenizer.pad_token = tokenizer.eos_token
    def generate(prompt: str) -> str:
        encoded = tokenizer(prompt, return_tensors="pt", truncation=False)
        n = encoded["input_ids"].shape[1]
        if context_limit and n + max_new_tokens > context_limit:
            raise ValueError(f"Prompt ({n}) plus generation ({max_new_tokens}) exceeds context limit ({context_limit}).")
        encoded = {k: v.to(device) for k, v in encoded.items()}
        with torch.inference_mode():
            out = model.generate(**encoded, max_new_tokens=max_new_tokens, do_sample=False,
                                 pad_token_id=tokenizer.pad_token_id, eos_token_id=tokenizer.eos_token_id)
        return tokenizer.decode(out[0, n:], skip_special_tokens=True).strip()
    return generate


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--model", required=True, help="Same base model ID/path used for every method")
    ap.add_argument("--output", default="results/llm/suite")
    ap.add_argument("--methods", nargs="+", choices=METHODS, default=list(METHODS))
    ap.add_argument("--warmup-epochs", type=int, default=1)
    ap.add_argument("--epochs", type=int, default=1)
    ap.add_argument("--learning-rate", type=float, default=2e-5)
    ap.add_argument("--beta", type=float, default=.1)
    ap.add_argument("--max-length", type=int, default=256)
    ap.add_argument("--context-sizes", nargs="+", type=int, default=[8, 32])
    ap.add_argument("--max-new-tokens", type=int, default=32)
    ap.add_argument("--full-niah", action="store_true", help="Also run the exhaustive matched NIAH grid for publication-grade comparison; substantially more expensive")
    ap.add_argument("--force-audit-escalation", action="store_true", help="Always run the broader adaptive-audit probes, even when initial evidence appears confident")
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--device", choices=["auto", "cpu", "cuda", "mps"], default="auto")
    args = ap.parse_args()
    if args.epochs < 1 or args.warmup_epochs < 0 or args.max_new_tokens < 1:
        ap.error("epochs/max-new-tokens must be positive and warmup-epochs non-negative")
    if not args.context_sizes or any(n < 0 for n in args.context_sizes):
        ap.error("context sizes must be a non-empty list of non-negative integers")
    random.seed(args.seed); np.random.seed(args.seed)
    try:
        import torch
    except ImportError as exc:
        raise SystemExit("Install optional dependencies with: python3 -m pip install -r requirements-llm.txt") from exc
    torch.manual_seed(args.seed)
    facts = build_synthetic_knowledge()
    forget = [f for f in facts if f.split == "forget"]
    retain = [f for f in facts if f.split == "retain"]
    out = Path(args.output); out.mkdir(parents=True, exist_ok=True)
    full_cases = build_niah_cases(facts, context_sizes=args.context_sizes,
                                  positions=("beginning", "middle", "end"),
                                  prompt_styles=("direct", "paraphrase", "completion"),
                                  context_modes=("present", "absent"))
    initial_cases = build_niah_cases(facts, context_sizes=(min(args.context_sizes),),
                                     positions=("middle",), prompt_styles=("direct",),
                                     context_modes=("present", "absent"))
    escalation_cases = build_niah_cases(facts, context_sizes=args.context_sizes,
                                        positions=("beginning", "middle", "end"),
                                        prompt_styles=("paraphrase", "completion"),
                                        context_modes=("present", "absent"))
    summary = {"suite": "RENA-LLM-matched-suite-v1", "base_model": args.model,
               "seed": args.seed, "knowledge_sha256": knowledge_hash(facts),
               "protocol": "Each method loaded independently from identical base model ID/path; non-reference methods receive mixed-fact warmup before unlearning.",
               "methods": {}, "limitations": [
                   "Synthetic facts provide controlled debugging evidence, not a substitute for established domain benchmarks.",
                   "Exact-match NIAH scoring can miss semantic or indirect disclosure.",
                   "Behavioral metrics do not prove physical parameter erasure.",
                   "Results depend on base model, tokenizer, compute, and hyperparameters."]}

    # Unmodified pretrained baseline is evaluated with the exact same full NIAH cases.
    base_model, base_tokenizer, base_device = load_model(args.model, args.device)
    base_niah = run_niah_benchmark(initial_cases, generator_for(base_model, base_tokenizer, base_device, args.max_new_tokens))
    base_niah.update({"model": args.model, "method": "base_model", "seed": args.seed, "evaluation_scope": "adaptive_initial_probes"})
    (out / "base_model_niah_initial.json").write_text(json.dumps(base_niah, indent=2, ensure_ascii=False), encoding="utf-8")
    summary["base_model"] = {k: base_niah.get(k) for k in ("forget_parametric_disclosure_rate", "forget_contextual_retrieval_rate", "retain_retrieval_rate", "case_count")}
    if args.full_niah:
        base_full = run_niah_benchmark(full_cases, generator_for(base_model, base_tokenizer, base_device, args.max_new_tokens))
        base_full.update({"model": args.model, "method": "base_model", "seed": args.seed, "evaluation_scope": "full_matched_grid"})
        (out / "base_model_niah_full.json").write_text(json.dumps(base_full, indent=2, ensure_ascii=False), encoding="utf-8")
        summary["base_model"]["full_niah"] = {k: base_full.get(k) for k in ("forget_parametric_disclosure_rate", "forget_contextual_retrieval_rate", "retain_retrieval_rate", "case_count")}
    del base_model, base_tokenizer

    for method in args.methods:
        print(f"[RENA] Loading fresh initialization for {method}", flush=True)
        model, tokenizer, device = load_model(args.model, args.device)
        method_dir = out / method; method_dir.mkdir(parents=True, exist_ok=True)
        started = time.time()
        warmup = []
        if method != "retain_only_retraining":
            warmup = train_on_facts(model, tokenizer, facts, epochs=args.warmup_epochs,
                                    learning_rate=args.learning_rate, max_length=args.max_length, seed=args.seed)
        cfg = TrainConfig(method=method, epochs=args.epochs, learning_rate=args.learning_rate,
                          max_length=args.max_length, beta=args.beta, seed=args.seed)
        train_result = unlearn_model(model, tokenizer, forget, retain, cfg, str(method_dir / "checkpoint"))
        train_result["warmup_history"] = warmup
        train_result["base_model"] = args.model
        train_result["device"] = device
        train_result["elapsed_seconds"] = time.time() - started
        (method_dir / "training.json").write_text(json.dumps(train_result, indent=2), encoding="utf-8")
        generate = generator_for(model, tokenizer, device, args.max_new_tokens)

        # Run low-cost, matched direct probes first. The controller may escalate
        # to robustness probes; exhaustive NIAH is opt-in to avoid wasting the
        # adaptive audit's compute savings on every run.
        initial_result = run_niah_benchmark(initial_cases, generate)
        initial_result.update({"model": args.model, "method": method, "seed": args.seed, "evaluation_scope": "adaptive_initial_probes"})
        (method_dir / "niah_initial.json").write_text(json.dumps(initial_result, indent=2, ensure_ascii=False), encoding="utf-8")
        niah = initial_result
        if args.full_niah:
            niah = run_niah_benchmark(full_cases, generate)
            niah.update({"model": args.model, "method": method, "seed": args.seed, "evaluation_scope": "full_matched_grid",
                         "generation": {"do_sample": False, "max_new_tokens": args.max_new_tokens, "device": device}})
            (method_dir / "niah_full.json").write_text(json.dumps(niah, indent=2, ensure_ascii=False), encoding="utf-8")
        def metric_signal(value, metric, reliability=1.0, evidence_group=None):
            row = {"score": value, "metric": metric, "reliability": reliability,
                   "limitations": ["Lexical exact-match proxy; inspect saved case outputs."]}
            if evidence_group:
                row["evidence_group"] = evidence_group
            return row
        initial = {
            "forget_direct_absent": lambda: metric_signal(None if initial_result["forget_parametric_disclosure_rate"] is None else 1-initial_result["forget_parametric_disclosure_rate"], "1 - direct absent-context disclosure", evidence_group="parametric_disclosure"),
            "retain_direct_present": lambda: metric_signal(initial_result["retain_contextual_retrieval_rate"], "direct retain contextual retrieval", evidence_group="retain_utility"),
        }
        escalation_cache = {}
        def run_escalation():
            if "result" not in escalation_cache:
                result = run_niah_benchmark(escalation_cases, generate)
                escalation_cache["result"] = result
                (method_dir / "audit_escalation_niah.json").write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding="utf-8")
            result = escalation_cache["result"]
            forget_rows = [r for r in result["cases"] if r["target_split"] == "forget" and r["context_mode"] == "absent"]
            retain_rows = [r for r in result["cases"] if r["target_split"] == "retain" and r["context_mode"] == "present"]
            f_rate = sum(r["retrieved"] for r in forget_rows) / len(forget_rows) if forget_rows else None
            r_rate = sum(r["retrieved"] for r in retain_rows) / len(retain_rows) if retain_rows else None
            return f_rate, r_rate
        def escalation_forget_signal():
            f_rate, _ = run_escalation()
            return metric_signal(None if f_rate is None else 1 - f_rate,
                                 "1 - absent-context paraphrase/completion disclosure",
                                 reliability=0.8, evidence_group="parametric_disclosure")
        def escalation_retain_signal():
            _, r_rate = run_escalation()
            return metric_signal(r_rate, "retain contextual retrieval under paraphrase/completion",
                                 reliability=0.8, evidence_group="retain_utility")
        escalation = {
            "forget_paraphrase_completion": escalation_forget_signal,
            "retain_robust_contextual": escalation_retain_signal,
        }
        audit = run_adaptive_audit(initial, escalation, AuditPolicy(), force_escalation=args.force_audit_escalation)
        (method_dir / "audit.json").write_text(json.dumps(audit.to_dict(), indent=2), encoding="utf-8")
        summary["methods"][method] = {
            "checkpoint": str(method_dir / "checkpoint"),
            "evaluation_scope": niah.get("evaluation_scope", "adaptive_initial_probes"),
            "forget_parametric_disclosure_rate": niah["forget_parametric_disclosure_rate"],
            "forget_contextual_retrieval_rate": niah["forget_contextual_retrieval_rate"],
            "retain_retrieval_rate": niah["retain_retrieval_rate"],
            "retain_contextual_retrieval_rate": niah["retain_contextual_retrieval_rate"],
            "elapsed_seconds": train_result["elapsed_seconds"],
            "audit_status": audit.status,
            "audit_escalated": audit.escalated,
            "audit_evidence_count": len(audit.evidence),
            "audit_independent_group_count": audit.independent_group_count,
            "audit_disagreement": audit.disagreement,
            "training_history": train_result["history"],
        }
        print(f"[RENA] {method}: audit={audit.status}; parametric disclosure={niah['forget_parametric_disclosure_rate']}; retain retrieval={niah['retain_retrieval_rate']}", flush=True)
        del model, tokenizer
        if torch.cuda.is_available(): torch.cuda.empty_cache()
    (out / "suite_summary.json").write_text(json.dumps(summary, indent=2), encoding="utf-8")
    print(f"Saved matched suite to {out / 'suite_summary.json'}")

if __name__ == "__main__":
    main()
