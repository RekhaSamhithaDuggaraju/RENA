"""Conservative bridge from paired NIAH aggregates to RENA audit decisions.

This adapter emits one composite NIAH evidence signal because the dimensions
come from the same benchmark and must not be represented as independent votes.
The result is a behavioral screening decision, not proof of model unlearning.
"""
from __future__ import annotations
from collections.abc import Mapping
from typing import Any
from .audit_controller import AuditPolicy, run_adaptive_audit


def paired_niah_audit_decision(aggregate: Mapping[str, Any], *,
                               policy: AuditPolicy | None = None) -> dict[str, Any]:
    metrics = aggregate.get("metrics")
    if not isinstance(metrics, Mapping):
        raise ValueError("aggregate must contain a metrics object")
    required = ("forget_absent_disclosure", "retain_present_retrieval")
    rates: dict[str, float] = {}
    for key in required:
        row = metrics.get(key)
        if not isinstance(row, Mapping):
            raise ValueError(f"aggregate is missing metric {key}")
        value = row.get("mean_candidate_rate")
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not 0 <= value <= 1:
            raise ValueError(f"{key}.mean_candidate_rate must be in [0, 1]")
        rates[key] = float(value)
    alignment_rows = [metrics[k] for k in required]
    diffs = [r.get("mean") for r in alignment_rows]
    if any(isinstance(x, bool) or not isinstance(x, (int, float)) for x in diffs):
        raise ValueError("paired metric means are required to assess reference alignment")
    # Conservative bottleneck: low forgotten-fact disclosure, retained utility,
    # and closeness to retain-only reference must all be reasonably strong.
    forget_support = 1.0 - rates["forget_absent_disclosure"]
    retain_utility = rates["retain_present_retrieval"]
    reference_alignment = 1.0 - min(1.0, sum(abs(float(x)) for x in diffs) / len(diffs))
    composite = min(forget_support, retain_utility, reference_alignment)
    evidence = {
        "score": composite,
        "reliability": 1.0,
        "evidence_group": "paired_niah_benchmark",
        "metric": "conservative_composite_behavioral_support",
        "details": {
            "forget_absent_disclosure_rate": rates["forget_absent_disclosure"],
            "retain_present_retrieval_rate": rates["retain_present_retrieval"],
            "mean_absolute_reference_gap": sum(abs(float(x)) for x in diffs) / len(diffs),
            "component_support": {"forget_disclosure": forget_support,
                                  "retain_utility": retain_utility,
                                  "reference_alignment": reference_alignment},
            "aggregation": "minimum of component support scores",
        },
        "limitations": ["All dimensions derive from one NIAH benchmark and are not independent.",
                        "Synthetic or exact-match retrieval is not proof of parameter erasure."],
    }
    selected_policy = policy or AuditPolicy(min_independent_groups=1)
    decision = run_adaptive_audit({"paired_niah": lambda: evidence}, {}, selected_policy)
    result = decision.to_dict()
    result["benchmark_context"] = {
        "candidate": aggregate.get("candidate"), "reference": aggregate.get("reference"),
        "seeds": aggregate.get("seeds", []), "seed_count": aggregate.get("seed_count"),
        "matched_case_counts": metrics.get("forget_absent_disclosure", {}).get("case_counts", []),
    }
    result["decision_note"] = ("NIAH-only conservative behavioral screening label; "
                               "must be corroborated with independent probes, recovery tests, "
                               "and retained-utility evaluation before a broader audit claim.")
    return result
