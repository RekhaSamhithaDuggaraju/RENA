version: "3.9"
services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: rena
      POSTGRES_PASSWORD: ${RENA_POSTGRES_PASSWORD:?RENA_POSTGRES_PASSWORD must be set}
      POSTGRES_DB: rena
    ports: ["5432:5432"]
    volumes: ["rena_db_data:/var/lib/postgresql/data"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U rena -d rena"]
      interval: 5s
      timeout: 5s
      retries: 10
  backend:
    build: {context: ., dockerfile: backend/Dockerfile}
    environment:
      RENA_DATABASE_URL: postgresql://rena:${RENA_POSTGRES_PASSWORD:?RENA_POSTGRES_PASSWORD must be set}@db:5432/rena
      RENA_PRODUCTION: ${RENA_PRODUCTION:-1}
      RENA_AUTH_REQUIRED: ${RENA_AUTH_REQUIRED:-1}
      RENA_AUTH_SECRET: ${RENA_AUTH_SECRET:?RENA_AUTH_SECRET must be set}
      RENA_CERTIFICATE_SECRET: ${RENA_CERTIFICATE_SECRET:?RENA_CERTIFICATE_SECRET must be set}
      RENA_DATA_ROOT: /var/lib/rena
      RENA_MAX_UPLOAD_MB: ${RENA_MAX_UPLOAD_MB:-256}
      RENA_MAX_CONCURRENT_JOBS: ${RENA_MAX_CONCURRENT_JOBS:-2}
      RENA_JOB_TIMEOUT_SECONDS: ${RENA_JOB_TIMEOUT_SECONDS:-1800}
      RENA_CORS_ORIGINS: ${RENA_CORS_ORIGINS:-http://localhost:3000}
    ports: ["8000:8000"]
    volumes: ["rena_app_data:/var/lib/rena"]
    depends_on:
      db: {condition: service_healthy}
  frontend:
    build: {context: ./frontend, dockerfile: Dockerfile}
    environment: {NEXT_PUBLIC_API_URL: http://localhost:8000}
    ports: ["3000:3000"]
    depends_on: [backend]
volumes:
  rena_db_data:
  rena_app_data:
