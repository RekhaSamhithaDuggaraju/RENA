const input="w-full rounded-xl border border-violet-300/20 bg-[#100b19] px-3 py-2.5 text-sm text-violet-50 outline-none focus:border-violet-400";
type Audit={id:string;name:string;status:string;facts?:any[];questions?:any[];target?:any;protocol?:any;phases?:any;};
export default function ForgettingAuditPage(){
 const [audit,setAudit]=useState<Audit|null>(null),[name,setName]=useState("My forgetting audit"),[target,setTarget]=useState("guided"),[model,setModel]=useState(""),[baseUrl,setBaseUrl]=useState("http://localhost:11434"),[apiKeyEnv,setApiKeyEnv]=useState("GEMINI_API_KEY"),[tier,setTier]=useState("unspecified"),[referenceType,setReferenceType]=useState("guided"),[referenceModel,setReferenceModel]=useState(""),[referenceBaseUrl,setReferenceBaseUrl]=useState("http://localhost:11434"),[referenceApiKeyEnv,setReferenceApiKeyEnv]=useState("GEMINI_API_KEY"),[referenceTier,setReferenceTier]=useState("never-exposed control"),[method,setMethod]=useState("conversation"),[forgetNotes,setForgetNotes]=useState("I performed the target system's supported forget/delete operation."),[fact,setFact]=useState(""),[answer,setAnswer]=useState(""),[targetQuestion,setTargetQuestion]=useState("What is the exact target information?"),[retainedQ,setRetainedQ]=useState(""),[retainedA,setRetainedA]=useState(""),[question,setQuestion]=useState(""),[questionFact,setQuestionFact]=useState(""),[phase,setPhase]=useState("baseline"),[manualQ,setManualQ]=useState(""),[manualAnswer,setManualAnswer]=useState(""),[report,setReport]=useState<any>(null),[exposureResults,setExposureResults]=useState<any[]>([]),[editValues,setEditValues]=useState<Record<string,string>>({}),[message,setMessage]=useState(""),[error,setError]=useState(""),[busy,setBusy]=useState(false);
 async function req(path:string,init:RequestInit={}){const headers=new Headers(init.headers||{});const auth=authHeaders();Object.entries(auth).forEach(([k,v])=>headers.set(k,v));const r=await fetch(API+path,{...init,headers,cache:"no-store"});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.detail||`Request failed (${r.status})`);return j;}
 async function act(fn:()=>Promise<any>){setBusy(true);setError("");setMessage("");try{const result=await fn();setMessage(typeof result?.message==="string"?result.message:"Done.");if(audit?.id){const fresh=await req(`/forgetting-audits/${audit.id}`);setAudit(fresh)}return result}catch(e){setError((e as Error).message);return null}finally{setBusy(false)}}
 async function create(){const j=await act(()=>req("/forgetting-audits",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name,target_type:target,model,base_url:baseUrl,api_key_env:apiKeyEnv,tier_label:tier,reference_target_type:referenceType,reference_model:referenceModel,reference_base_url:referenceBaseUrl,reference_api_key_env:referenceApiKeyEnv,reference_tier_label:referenceTier,exposure_method:method,forget_operation:forgetNotes,questions_per_fact:5})}));if(j?.id){const fresh=await req(`/forgetting-audits/${j.id}`);setAudit(fresh)}}
 async function upload(file?:File){if(!file||!audit)return;await act(async()=>{const fd=new FormData();fd.append("file",file);return req(`/forgetting-audits/${audit.id}/dataset`,{method:"POST",body:fd})})}
 async function addFact(){if(!audit)return;const j=await act(()=>req(`/forgetting-audits/${audit.id}/facts`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({facts:[{fact,expected_answer:answer,target_question:targetQuestion,retained_question:retainedQ,retained_answer:retainedA}]})}));if(j){setFact("");setAnswer("");setTargetQuestion("What is the exact target information?");setRetainedQ("");setRetainedA("")}}
 async function generate(){if(audit)await act(()=>req(`/forgetting-audits/${audit.id}/generate-probes`,{method:"POST"}))}
 async function addQuestion(){if(!audit)return;const j=await act(()=>req(`/forgetting-audits/${audit.id}/questions`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({fact_id:questionFact,question,kind:"custom"})}));if(j)setQuestion("")}
 async function editQuestion(q:any){if(!audit)return;await act(()=>req(`/forgetting-audits/${audit.id}/questions/${q.id}`,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({question:editValues[q.id]??q.question})}))}
 async function run(p:string){if(!audit)return;await act(()=>req(`/forgetting-audits/${audit.id}/run/${p}`,{method:"POST"}));setPhase(p)}
 async function expose(){if(!audit)return;const j=await act(()=>req(`/forgetting-audits/${audit.id}/expose`,{method:"POST"}));if(j?.results)setExposureResults(j.results)}
 async function mark(){if(audit)await act(()=>req(`/forgetting-audits/${audit.id}/mark-forgotten`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({operation_notes:forgetNotes})}))}
 async function manualSubmit(){if(!audit||!manualQ)return;const j=await act(()=>req(`/forgetting-audits/${audit.id}/manual-response`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({question_id:manualQ,phase,response:manualAnswer})}));if(j)setManualAnswer("")}
 async function loadReport(){if(!audit)return;const j=await act(()=>req(`/forgetting-audits/${audit.id}/report`));if(j)setReport(j)}
 const questions=audit?.questions||[],facts=audit?.facts||[];
 return <main className="min-h-screen bg-[#090610] text-white"><header className="border-b border-violet-300/10 px-5 py-4"><div className="mx-auto flex max-w-6xl items-center justify-between"><Link href="/" className="font-bold tracking-widest text-violet-100">RENA <span className="text-amber-300">/</span> AUDIT WORKSPACE</Link><Link href="/llm" className="text-sm text-violet-300 hover:text-white">LLM lab ↗</Link></div></header><div className="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6"><div><p className="text-xs font-semibold tracking-[.25em] text-violet-300">USER-CONTROLLED FORGETTING-CLAIM AUDIT</p><h1 className="mt-2 text-3xl font-bold sm:text-4xl">Test what an AI still reveals<span className="text-amber-300">.</span></h1><p className="mt-3 max-w-3xl text-sm leading-6 text-violet-100/70">Upload or enter synthetic/authorised facts, establish a baseline, perform the target system's forget operation, then run matched probes. RENA records observable responses; it cannot prove hidden-weight or provider-side deletion.</p></div>
 {error&&<div className="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3 text-sm text-rose-200">{error}</div>}{message&&<div className="rounded-xl border border-emerald-400/20 bg-emerald-500/5 p-3 text-sm text-emerald-200">{message}</div>}
 {!audit?<section className="rounded-2xl border border-violet-300/15 bg-white/[.03] p-5"><h2 className="text-xl font-semibold">1. Configure the target</h2><div className="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><label className="text-xs text-violet-200">Experiment name<input className={`${input} mt-2`} value={name} onChange={e=>setName(e.target.value)}/></label><label className="text-xs text-violet-200">Target type<select className={`${input} mt-2`} value={target} onChange={e=>setTarget(e.target.value)}><option value="guided">Guided/manual consumer app</option><option value="ollama">Local Ollama</option><option value="openai_compatible">OpenAI-compatible API</option><option value="gemini">Gemini API</option></select></label><label className="text-xs text-violet-200">Model ID<input className={`${input} mt-2`} value={model} onChange={e=>setModel(e.target.value)} placeholder="gemini-2.5-flash / llama3.2"/></label><label className="text-xs text-violet-200">Base URL<input className={`${input} mt-2`} value={baseUrl} onChange={e=>setBaseUrl(e.target.value)} disabled={target==="guided"||target==="gemini"}/></label><label className="text-xs text-violet-200">API key environment variable name<input className={`${input} mt-2`} value={apiKeyEnv} onChange={e=>setApiKeyEnv(e.target.value)} disabled={target==="guided"||target==="ollama"}/><small className="mt-1 block text-violet-200/50">The secret itself is never stored. Configure this variable on the backend.</small></label><label className="text-xs text-violet-200">Tier / variant label<input className={`${input} mt-2`} value={tier} onChange={e=>setTier(e.target.value)} placeholder="free, paid, model version"/></label><label className="text-xs text-violet-200">Never-exposed reference type<select className={`${input} mt-2`} value={referenceType} onChange={e=>setReferenceType(e.target.value)}><option value="guided">Guided/manual reference</option><option value="ollama">Local Ollama reference</option><option value="openai_compatible">OpenAI-compatible reference API</option><option value="gemini">Gemini reference API</option></select><small className="mt-1 block text-violet-200/50">Use a separate instance/session that has never received the target facts.</small></label><label className="text-xs text-violet-200">Reference model ID<input className={`${input} mt-2`} value={referenceModel} onChange={e=>setReferenceModel(e.target.value)} placeholder="Same model/version if possible" disabled={referenceType==="guided"}/></label><label className="text-xs text-violet-200">Reference base URL<input className={`${input} mt-2`} value={referenceBaseUrl} onChange={e=>setReferenceBaseUrl(e.target.value)} disabled={referenceType==="guided"||referenceType==="gemini"}/></label><label className="text-xs text-violet-200">Reference API key environment variable<input className={`${input} mt-2`} value={referenceApiKeyEnv} onChange={e=>setReferenceApiKeyEnv(e.target.value)} disabled={referenceType==="guided"||referenceType==="ollama"}/></label><label className="text-xs text-violet-200">Reference tier / version label<input className={`${input} mt-2`} value={referenceTier} onChange={e=>setReferenceTier(e.target.value)}/></label><label className="text-xs text-violet-200">Exposure type<select className={`${input} mt-2`} value={method} onChange={e=>setMethod(e.target.value)}><option value="conversation">Conversation / context</option><option value="saved_memory">Saved memory</option><option value="rag_document">RAG document</option><option value="custom">Custom / other</option></select></label></div><button disabled={busy||!name.trim()||(target!=="guided"&&!model.trim())} onClick={()=>void create()} className="mt-5 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold disabled:opacity-40">{busy?"Creating…":"Create audit"}</button></section>:<section className="rounded-2xl border border-violet-300/15 bg-white/[.03] p-5"><div className="flex flex-wrap items-start justify-between gap-3"><div><h2 className="text-xl font-semibold">{audit.name}</h2><p className="mt-1 text-xs text-violet-200/60">ID {audit.id} · target: {audit.target?.type} · {audit.target?.tier_label}</p></div><button onClick={()=>{setAudit(null);setReport(null)}} className="rounded-lg border border-violet-300/20 px-3 py-2 text-xs">New audit</button></div><p className="mt-3 text-xs text-violet-100/70">Status: {audit.status} · {facts.length} facts · {questions.length} questions</p></section>}
 {audit&&<><section className="grid gap-5 lg:grid-cols-2"><div className="rounded-2xl border border-violet-300/15 bg-white/[.03] p-5"><h2 className="text-xl font-semibold">2. Upload a dataset</h2><p className="mt-2 text-sm text-violet-100/65">Accepted: CSV, JSON, JSONL · max 5 MB / 500 facts. Fields: <code>fact</code>, <code>expected_answer</code> (or <code>answer</code>), optional <code>exposure_text</code>, <code>retained_question</code>, <code>retained_answer</code>.</p><input className="mt-4 block w-full text-sm text-violet-100 file:mr-3 file:rounded-lg file:border-0 file:bg-violet-600 file:px-3 file:py-2 file:text-white" type="file" accept=".csv,.json,.jsonl,.ndjson" onChange={e=>void upload(e.target.files?.[0])}/><p className="mt-3 text-xs text-amber-200/80">Use synthetic canaries or data you are authorised to test. Uploading replaces current facts.</p></div><div className="rounded-2xl border border-violet-300/15 bg-white/[.03] p-5"><h2 className="text-xl font-semibold">3. Add facts manually</h2><div className="mt-3 grid gap-3"><label className="text-xs text-violet-200">Target fact<input className={`${input} mt-1`} value={fact} onChange={e=>setFact(e.target.value)} placeholder="Project code is VIOLET-7319"/></label><label className="text-xs text-violet-200">Expected target answer<input className={`${input} mt-1`} value={answer} onChange={e=>setAnswer(e.target.value)} placeholder="VIOLET-7319"/></label><label className="text-xs text-violet-200">Question that tests the fact (must not reveal the answer)<input className={`${input} mt-1`} value={targetQuestion} onChange={e=>setTargetQuestion(e.target.value)} placeholder="What is the project code?"/></label><label className="text-xs text-violet-200">Retained-utility question (optional)<input className={`${input} mt-1`} value={retainedQ} onChange={e=>setRetainedQ(e.target.value)} placeholder="An unrelated permitted question"/></label><label className="text-xs text-violet-200">Expected retained answer (optional)<input className={`${input} mt-1`} value={retainedA} onChange={e=>setRetainedA(e.target.value)}/></label><button disabled={busy||!fact.trim()||!answer.trim()} onClick={()=>void addFact()} className="rounded-xl bg-violet-600 px-4 py-2.5 text-sm disabled:opacity-40">Add fact</button></div></div></section>
 <section className="rounded-2xl border border-violet-300/15 bg-white/[.03] p-5"><h2 className="text-xl font-semibold">4. Generate and customise probes</h2><p className="mt-2 text-sm text-violet-100/65">Generated probes are drafts; review them before formal evaluation. User-written questions are supported too.</p><div className="mt-4 flex flex-wrap gap-3"><button disabled={busy||facts.length===0} onClick={()=>void generate()} className="rounded-xl bg-violet-600 px-4 py-2.5 text-sm disabled:opacity-40">Generate probe set</button><button disabled={busy||!questions.length} onClick={()=>void loadReport()} className="rounded-xl border border-violet-300/25 px-4 py-2.5 text-sm">Refresh report</button></div><div className="mt-4 grid gap-3 sm:grid-cols-[1fr_2fr_auto]"><select className={input} value={questionFact} onChange={e=>setQuestionFact(e.target.value)}><option value="">Select fact for custom question</option>{facts.map(f=><option key={f.id} value={f.id}>{f.fact.slice(0,80)}</option>)}</select><input className={input} value={question} onChange={e=>setQuestion(e.target.value)} placeholder="Write your own question"/><button disabled={busy||!questionFact||!question.trim()} onClick={()=>void addQuestion()} className="rounded-xl border border-violet-300/25 px-4 py-2 text-sm disabled:opacity-40">Add question</button></div>{questions.map((q:any)=><details key={q.id} className="mt-3 rounded-xl border border-violet-300/10 bg-black/20 p-3"><summary className="cursor-pointer text-sm text-violet-100">{q.kind} · {q.question}</summary><div className="mt-3 grid gap-2 sm:grid-cols-[1fr_auto]"><input className={input} value={editValues[q.id]??q.question} onChange={e=>setEditValues(v=>({...v,[q.id]:e.target.value}))} disabled={!!audit.phases?.baseline}/><button disabled={busy||!!audit.phases?.baseline||!(editValues[q.id]??q.question).trim()} onClick={()=>void editQuestion(q)} className="rounded-lg border border-violet-300/25 px-3 py-2 text-xs disabled:opacity-40">Save edit</button></div><div className="mt-2 text-xs text-violet-200/60">ID {q.id} · Responses: {Object.keys(q.responses||{}).join(", ")||"none"}</div></details>)}</section>
 <section className="rounded-2xl border border-violet-300/15 bg-white/[.03] p-5"><h2 className="text-xl font-semibold">5. Run the controlled experiment</h2><ol className="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-violet-100/70"><li>Verify the AI can retrieve target information before forgetting. In guided mode, paste each question into the target and save its response below.</li><li>Perform the target's actual forget/delete operation yourself. RENA records what you report; it does not universally operate provider deletion.</li><li>Run post-forgetting probes and the same questions against a never-exposed reference instance/version.</li></ol><label className="mt-4 block text-xs text-violet-200">Forgetting operation / settings / timestamp notes<textarea className={`${input} mt-2 min-h-20`} value={forgetNotes} onChange={e=>setForgetNotes(e.target.value)}/></label><div className="mt-4 flex flex-wrap gap-3"><button disabled={busy||!facts.length||!questions.length} onClick={()=>void run("baseline")} className="rounded-xl bg-violet-600 px-4 py-3 text-sm disabled:opacity-40">Run baseline probes</button><button disabled={busy||!audit.phases?.baseline} onClick={()=>void mark()} className="rounded-xl border border-amber-300/30 px-4 py-3 text-sm text-amber-200 disabled:opacity-40">Record forget operation</button><button disabled={busy||!audit.phases?.forget_record} onClick={()=>void run("post_forget")} className="rounded-xl border border-violet-300/25 px-4 py-3 text-sm disabled:opacity-40">Run post-forgetting probes</button><button disabled={busy||!questions.length} onClick={()=>void run("never_exposed")} className="rounded-xl border border-emerald-300/25 px-4 py-3 text-sm text-emerald-200 disabled:opacity-40">Run never-exposed control</button></div>{exposureResults.length>0&&<div className="mt-4 rounded-xl border border-amber-300/20 bg-amber-300/[.04] p-3"><p className="text-sm font-semibold text-amber-200">Exposure prompts / outcomes</p>{exposureResults.map((x:any)=><div key={x.fact_id} className="mt-3 text-xs leading-5 text-violet-100/80"><b>{x.fact_id} · {x.status}</b><pre className="mt-1 whitespace-pre-wrap">{x.exposure_prompt||x.response||x.error||"No prompt returned"}</pre></div>)}</div>}<div className="mt-5 grid gap-3 sm:grid-cols-3"><label className="text-xs text-violet-200">Manual response phase<select className={`${input} mt-2`} value={phase} onChange={e=>setPhase(e.target.value)}><option value="baseline">Baseline</option><option value="post_forget">Post-forget</option><option value="never_exposed">Never-exposed reference</option></select></label><label className="text-xs text-violet-200">Question<select className={`${input} mt-2`} value={manualQ} onChange={e=>setManualQ(e.target.value)}><option value="">Select question</option>{questions.map((q:any)=><option key={q.id} value={q.id}>{q.kind}: {q.question.slice(0,90)}</option>)}</select></label><label className="text-xs text-violet-200">Paste AI response<textarea className={`${input} mt-2 min-h-20`} value={manualAnswer} onChange={e=>setManualAnswer(e.target.value)}/></label></div><button disabled={busy||!manualQ||!manualAnswer.trim()} onClick={()=>void manualSubmit()} className="mt-3 rounded-xl border border-violet-300/25 px-4 py-2.5 text-sm disabled:opacity-40">Save manual response</button></section>
 {report&&<section className="rounded-2xl border border-amber-300/20 bg-amber-300/[.04] p-5"><h2 className="text-xl font-semibold">Audit report</h2><p className="mt-3 font-semibold text-amber-200">{report.verdict}</p><p className="mt-2 text-sm text-violet-100/70">{report.verdict_scope}</p><pre className="mt-4 max-h-96 overflow-auto whitespace-pre-wrap rounded-xl bg-black/30 p-3 text-xs text-violet-100/70">{JSON.stringify(report.counts,null,2)}</pre><details className="mt-3"><summary className="cursor-pointer text-sm">Show full evidence JSON</summary><pre className="mt-2 max-h-[32rem] overflow-auto whitespace-pre-wrap rounded-xl bg-black/30 p-3 text-xs text-violet-100/70">{JSON.stringify(report,null,2)}</pre></details></section>}</>}
 <footer className="border-t border-violet-300/10 pt-4 text-xs leading-5 text-violet-100/45">RENA research prototype · lexical screening is not semantic proof · no match is not proof of deletion · do not upload real sensitive personal data.</footer></div></main>
}
